{
  flake.modules.nixos.router = {

let
  # ── Edit these ──────────────────────────────────────────────────────
  wanIF  = "eth0";
  lanIF  = "br-lan";
  lanNet = "10.25.0.0/24";
in
{
  networking.nftables.enable = true;
  networking.firewall.enable = false;   # we own the rules fully

  networking.nftables.ruleset = ''
    #!/usr/sbin/nft -f
    flush ruleset

    ####################################################################
    # Tables
    ####################################################################
    table inet filter {
      ##################################################################
      # Sets
      ##################################################################
      set bogons4 {
        type ipv4_addr
        flags interval
        elements = {
          0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10,
          127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
          192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16,
          198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
          224.0.0.0/4, 240.0.0.0/4
        }
      }

      # CrowdSec will manage this set when the firewall-bouncer is active
      set crowdsec-blacklists {
        type ipv4_addr
        flags timeout
      }

      ##################################################################
      # Chains
      ##################################################################
      chain input {
        type filter hook input priority 0; policy drop;

        # Loopback
        iif "lo" accept

        # Established / related
        ct state established,related accept

        # Drop invalid
        ct state invalid drop

        # Bogons on WAN
        iifname "${wanIF}" ip saddr @bogons4 drop

        # CrowdSec bans
        ip saddr @crowdsec-blacklists drop

        # ICMP (rate-limited)
        ip protocol icmp icmp type echo-request limit rate 5/second accept
        ip protocol icmp accept

        # SSH from LAN only
        iifname "${lanIF}" tcp dport 22 accept

        # DNS + DHCP from LAN
        iifname "${lanIF}" udp dport { 53, 67 } accept
        iifname "${lanIF}" tcp dport 53 accept

        # Optional: allow metrics / local services from LAN
        # iifname "${lanIF}" tcp dport { 9100, 8080 } accept

        # Everything else from LAN is allowed (adjust if you want stricter)
        iifname "${lanIF}" accept

        # Log and drop the rest (optional)
        # log prefix "nft-input-drop: " flags all
        drop
      }

      chain forward {
        type filter hook forward priority 0; policy drop;

        # Established / related
        ct state established,related accept
        ct state invalid drop

        # Bogons
        iifname "${wanIF}" ip saddr @bogons4 drop
        oifname "${wanIF}" ip daddr @bogons4 drop

        # CrowdSec
        ip saddr @crowdsec-blacklists drop

        # LAN → WAN
        iifname "\( {lanIF}" oifname " \){wanIF}" accept

        # WAN → LAN only for established (already covered above)
        # Add port-forwards here if needed, e.g.:
        # iifname "${wanIF}" tcp dport 443 dnat to 10.25.0.10

        drop
      }

      chain output {
        type filter hook output priority 0; policy accept;
      }
    }

    ####################################################################
    # NAT
    ####################################################################
    table ip nat {
      chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        oifname "${wanIF}" masquerade
      }

      chain prerouting {
        type nat hook prerouting priority -100; policy accept;
        # Port forwards go here, example:
        # iifname "${wanIF}" tcp dport 443 dnat to 10.25.0.10:443
      }
    }
  '';
}